states = ["A", "B", "C", "D"]
actions = {
    "A": [("Right", "B", 0), ("Down", "C", 0)],
    "B": [("Left", "A", 0), ("Down", "D", 10)],
    "C": [("Up", "A", 0), ("Right", "D", 10)],
    "D": []
}
value = {s: 0 for s in states}
gamma = 0.9
for _ in range(100):
    new_value = value.copy()

    for s in states:
        if actions[s]:
            new_value[s] = max(
                r + gamma * value[next_s]
                for a, next_s, r in actions[s]
            )

    value = new_value
policy = {}
for s in states:
    if actions[s]:
        policy[s] = max(
            actions[s],
            key=lambda x: x[2] + gamma * value[x[1]]
        )[0]
print("Value Function:", value)
print("Optimal Policy:", policy)
